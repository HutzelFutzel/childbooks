rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Shape guard for the profile root doc. Validates known fields' types and
    // caps the field count so the doc can grow over time without being abused.
    // Unknown keys (e.g. future additions) are tolerated under the count cap.
    function isValidProfile(d) {
      return d.keys().size() <= 40
        && (!('schemaVersion' in d) || d.schemaVersion is int)
        && (!('displayName' in d) || d.displayName == null || (d.displayName is string && d.displayName.size() <= 200))
        && (!('email' in d) || d.email == null || (d.email is string && d.email.size() <= 320))
        && (!('photoURL' in d) || d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 2000))
        && (!('defaultAddressId' in d) || d.defaultAddressId == null || (d.defaultAddressId is string && d.defaultAddressId.size() <= 200))
        && (!('locale' in d) || d.locale == null || (d.locale is string && d.locale.size() <= 35))
        && (!('currency' in d) || d.currency == null || (d.currency is string && d.currency.size() <= 3))
        && (!('marketingOptIn' in d) || d.marketingOptIn is bool);
    }

    // Shape guard for a saved address. Required fields must be present strings
    // within sane bounds; optional fields are type-checked only when present.
    function isValidAddress(d) {
      return d.keys().size() <= 20
        && d.recipientName is string && d.recipientName.size() <= 200
        && d.line1 is string && d.line1.size() <= 300
        && d.city is string && d.city.size() <= 200
        && d.postal is string && d.postal.size() <= 40
        && d.country is string && d.country.size() <= 2
        && (!('label' in d) || (d.label is string && d.label.size() <= 120))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 60))
        && (!('email' in d) || (d.email is string && d.email.size() <= 320))
        && (!('line2' in d) || (d.line2 is string && d.line2.size() <= 300))
        && (!('region' in d) || (d.region is string && d.region.size() <= 200));
    }

    // Per-user private space: a signed-in user may READ all of their own docs
    // under users/{uid}/**. The backend (Admin SDK) bypasses these rules.
    match /users/{uid}/{document=**} {
      allow read: if signedInAs(uid);
    }
    // Client WRITES are limited to the app's own data (project/settings KV and
    // generation jobs). Usage/cost records (users/{uid}/usage,
    // users/{uid}/usageAggregates) and the Spark ledger (users/{uid}/sparksLedger)
    // are written only by the backend, so they stay read-only to the client and
    // can't be forged or deleted (they fall through to the default-deny write).
    match /users/{uid}/store/{document=**} {
      allow write: if signedInAs(uid);
    }
    // The client only CREATES the job document (its task specs live on that doc);
    // the backend expands it into the `tasks` subcollection and writes every
    // render result there. Scoping the write to the job doc itself (not
    // `{document=**}`) keeps the task subcollection backend-only, so a client
    // can't forge a completed task/result.
    match /users/{uid}/jobs/{jobId} {
      allow write: if signedInAs(uid);
    }
    // Per-task docs are read by the owner (also via the project-scoped
    // collection-group query, which needs a rule that authorizes by the doc's
    // own `uid` field — the path wildcard can't be correlated to a field filter
    // for group queries). Writes fall through to default-deny (backend only).
    match /{path=**}/tasks/{taskId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // The Spark balance is backend-authoritative (written only via the Admin SDK
    // after a transactional ledger entry). A client may carry it through an
    // unrelated profile write, but must never CHANGE it — otherwise anyone could
    // mint themselves Sparks by patching their own profile doc.
    function sparkBalanceUnchanged() {
      return !('sparkBalance' in request.resource.data)
        || (resource != null && 'sparkBalance' in resource.data
            && request.resource.data.sparkBalance == resource.data.sparkBalance);
    }

    // Referral attribution + reward state are backend-authoritative too (set
    // via /referrals/* routes and the Stripe webhook). A client patching its
    // own profile must never introduce or alter them.
    //
    // `referralRewardCount` is the one the lifetime cap reads, so a client that
    // could reset it would grant itself unlimited rewarded referrals;
    // `firstBookCompletedAt` is what makes the activation trigger fire once.
    function referralFieldsUnchanged() {
      return fieldUnchanged('referralCode')
        && fieldUnchanged('referredBy')
        && fieldUnchanged('referredAt')
        && fieldUnchanged('referralInvitationId')
        && fieldUnchanged('referralRewardedAt')
        && fieldUnchanged('referralRewardCount')
        && fieldUnchanged('referredAsGuest')
        && fieldUnchanged('firstBookCompletedAt');
    }

    function fieldUnchanged(f) {
      return !(f in request.resource.data)
        || (resource != null && f in resource.data
            && request.resource.data[f] == resource.data[f]);
    }

    // Metering rollups the backend keeps on the profile doc: the per-user
    // project sequence counter and lifetime cost/spend totals. They feed admin
    // reporting and the "which book is this for them" number, so a client that
    // could rewrite them could rewrite the analysis.
    function meteringFieldsUnchanged() {
      return fieldUnchanged('projectCounter')
        && fieldUnchanged('projectCount')
        && fieldUnchanged('lifetime');
    }

    // What the backend worked out about the buyer from their survey answers
    // (parent, grandparent, has children of their own). Campaign conditions
    // target on it, so a client that could set it could hand itself any offer
    // aimed at any segment. Written only through the survey routes.
    function surveyProfileUnchanged() {
      return fieldUnchanged('surveyProfile');
    }

    // Profile root doc + saved address book. Owner-only, with field validation
    // on writes. The broad `users/{uid}/**` read rule above does NOT cover the
    // `users/{uid}` doc itself (the recursive wildcard needs >=1 extra segment),
    // so the profile doc gets its own read rule. Orders keep their own
    // authoritative copy of the shipping address — these just prefill checkout.
    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow write: if signedInAs(uid) && isValidProfile(request.resource.data)
        && sparkBalanceUnchanged() && referralFieldsUnchanged() && meteringFieldsUnchanged()
        && surveyProfileUnchanged();
    }
    match /users/{uid}/addresses/{addressId} {
      allow create, update: if signedInAs(uid) && isValidAddress(request.resource.data);
      allow delete: if signedInAs(uid);
    }

    // Admin membership: the source of truth for admin status, set in the
    // Firebase console. A user may read their own doc (to drive the cosmetic UI
    // gate); writes are denied to all clients (set in the console / Admin SDK).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Global, admin-managed configuration (model config, art-style examples…).
    // World-readable so the wizard + client can resolve them; writes only ever
    // happen through the backend (Admin SDK) after `requireAdmin`.
    // Exceptions, admin-only:
    //   - `modelCosts`, the raw provider rate table — the storefront reads the
    //     derived `modelCostsPublic` projection instead (flat per-image
    //     estimates, written by the backend on every save).
    //   - `emailConfig`, which MOVED to `adminSettings/emailConfig` because it
    //     holds every inbox address the product uses. The backend deletes the old
    //     doc on its first read after deploy; this keeps it unreadable in the
    //     meantime, and keeps the path shut if anything ever recreates it.
    match /appConfig/{doc} {
      allow read: if !(doc in ['modelCosts', 'emailConfig']) || isAdmin();
      allow write: if false;
    }

    // Metering: the server-owned project mirrors and the per-user-call action
    // run records. Both are cross-user collections holding provider cost and
    // margin, and both are written and read exclusively through the Admin SDK
    // (which bypasses rules). Denied explicitly rather than by default so the
    // intent survives any future rule edit.
    match /projects/{doc} {
      allow read, write: if false;
    }
    match /actionRuns/{doc} {
      allow read, write: if false;
    }

    // Blog / articles. Full post bodies live in their own collection (they'd
    // outgrow a single appConfig doc). Published posts are world-readable so the
    // App Router can render article pages; drafts stay hidden. Writes only ever
    // happen through the admin-gated backend (Admin SDK). The lightweight index
    // projection is `appConfig/blogIndex`, already covered by the rule above.
    match /blog/{slug} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // Blog analytics aggregates (cookieless, first-party). Written only by the
    // backend (Admin SDK) from the tokenless `/blog-track` beacon; read only by
    // the admin dashboard via the admin-gated backend. Never client-accessible
    // — the per-day `days/{date}` dedupe docs hold rotating visitor hashes and
    // must not be exposed. The top-level deny-all already covers this, but we
    // spell it out for clarity.
    match /blogStats/{slug} {
      allow read, write: if false;
      match /days/{date} {
        allow read, write: if false;
      }
    }

    // Admin dashboard settings (exclusion lists, timezone, refresh interval) and
    // the email config. Holds the analytics exclusion list plus every inbox
    // address the product uses — the support inbox, the contact recipient and the
    // sender identities — so unlike `appConfig/*` it must NEVER be world-readable:
    // a public config doc hands an address harvester the whole set in one read,
    // without even loading the site. Read/written only via the admin-gated
    // backend (`/admin/config/email`).
    match /adminSettings/{doc} {
      allow read, write: if false;
    }

    // Contact-form submissions — the system of record for the public form (the
    // site publishes no email address, so this is the primary support channel).
    // Contains the sender's name, address and message, so it is never client-
    // readable; the admin dashboard reads it through the admin-gated backend.
    match /contactMessages/{ref} {
      allow read, write: if false;
    }

    // Affiliate-program applications — system of record for the public apply
    // form. Contains applicant PII (name, email, channel URLs), so never
    // client-readable; reviewed via Slack + backend.
    match /affiliateApplications/{ref} {
      allow read, write: if false;
    }

    // Fixed-window rate-limit counters for the tokenless contact endpoint. Keys
    // are hashed before use as document ids, so these hold no addresses — just
    // opaque counters. Written only by the backend; a Firestore TTL policy on
    // `expiresAt` reaps them. Shared with affiliate applications.
    match /contactRateLimits/{key} {
      allow read, write: if false;
    }

    // Append-only authentication event log, written by the Auth blocking
    // functions (Admin SDK). Read only via the admin-gated analytics routes.
    match /analyticsEvents/{doc} {
      allow read, write: if false;
    }

    // Local mirror of the Rewardful account (campaigns, affiliates, commissions,
    // payouts) plus the processed-webhook log. Rewardful is the source of truth;
    // these copies exist for the admin dashboard and to join commissions to our
    // own payments. They hold affiliates' names, emails and earnings, so they're
    // backend-only — the dashboard reads them through the admin-gated routes.
    // (The catch-all below would already deny these; they're spelled out because
    // money and third-party personal data deserve to be obvious, not implied.)
    match /affiliateCampaigns/{doc} {
      allow read, write: if false;
    }
    match /affiliatePartners/{doc} {
      allow read, write: if false;
    }
    match /affiliateCommissions/{doc} {
      allow read, write: if false;
    }
    match /affiliatePayouts/{doc} {
      allow read, write: if false;
    }
    match /affiliateWebhookEvents/{doc} {
      allow read, write: if false;
    }

    // The marketing campaign engine. All of it is backend-only, and all of it is
    // spelled out for the same reason the affiliate mirror is: this is money.
    //
    // `campaignEnrollments` in particular must never be client-WRITABLE — it
    // holds the FROZEN terms a payout is calculated from, so a client that could
    // edit it could write itself any offer it liked. `campaignRedemptions` is the
    // idempotency ledger, and `campaignCounters` is what enforces "first 100".
    // Customers see all of this through the admin-gated and `/account/offers`
    // routes instead. (The catch-all below would already deny them.)
    match /campaignEvents/{doc} {
      allow read, write: if false;
    }
    match /campaignEnrollments/{doc} {
      allow read, write: if false;
    }
    match /campaignRedemptions/{doc} {
      allow read, write: if false;
    }
    match /campaignCounters/{doc} {
      allow read, write: if false;
    }
    match /campaignStats/{doc} {
      allow read, write: if false;
    }
    // Profiling survey answers. Backend-only in BOTH directions, including for the
    // person who wrote them: a client that could write here could answer on behalf
    // of an account it doesn't own (poisoning every cross-tab the answers feed) or
    // re-answer to farm a "get Sparks for answering" campaign. Submissions go
    // through `/account/survey`, which validates against the live question set and
    // refuses a second answer. A customer's own answers are readable via the GDPR
    // export route.
    match /surveyResponses/{doc} {
      allow read, write: if false;
    }

    // Everything else is denied to direct client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
