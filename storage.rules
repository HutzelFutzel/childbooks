rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Per-user blob space: a signed-in user may read/write only their own
    // objects under users/{uid}/**. Generated images live here.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin-managed art-style example images. World-readable so the setup wizard
    // can show them; written only by the backend (Admin SDK) after `requireAdmin`.
    match /public/artStyles/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /public/branding/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-uploaded catalog pictures: print options (bindings, papers,
    // finishes), the books themselves, the digital edition and Spark packs.
    // World-readable so the storefront can show buyers what they're choosing;
    // written only by the backend (Admin SDK) after `requireAdmin`.
    match /public/catalogMedia/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-managed landing-page illustrations (inline drag-&-drop editor).
    // World-readable so the marketing site can render them; written only by the
    // backend (Admin SDK) after `requireAdmin`.
    match /public/site/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-managed blog cover images. World-readable so the public blog and the
    // admin blog editor's preview can show them; written only by the backend
    // (Admin SDK) after `requireAdmin`.
    match /public/blog/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // The QR code library's rendered images and centre-logo copies. World-
    // readable — a code baked into a printed book has to keep resolving for
    // anyone who scans it, indefinitely; written only by the backend (Admin
    // SDK) after `requireAdmin`, and by `renderQrCode`'s own preview path,
    // which never writes to Storage at all.
    match /public/qrcodes/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Backend-managed print assets are written via the Admin SDK (which bypasses
    // rules) and handed to Lulu through signed URLs — no client access needed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
