  <diagram id="first-look" name="3. First-look states">
    <mxGraphModel dx="1800" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="fl-title" value="Cast intake, one-tap style, then generation — staggered before the story opens" style="text;html=1;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1050" height="45" as="geometry"/></mxCell>
        <mxCell id="fl-a" value="A. Unified cast card (one card, everyone named)" style="swimlane;html=1;startSize=38;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="105" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="fl-a-msg" value="Let’s get Maya and Leo drawn first. Do you have a photo?&#xa;[ Maya 5 ]  [ Leo 3 ]  — a photo of them together works too" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;fontSize=16;" vertex="1" parent="fl-a"><mxGeometry x="30" y="70" width="450" height="70" as="geometry"/></mxCell>
        <mxCell id="fl-a-photo" value="Use a photo&#xa;Illustrate their likeness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;fontStyle=1;" vertex="1" parent="fl-a"><mxGeometry x="30" y="185" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-a-art" value="Use artwork&#xa;Keep design + derive style" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontStyle=1;" vertex="1" parent="fl-a"><mxGeometry x="270" y="185" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-a-desc" value="Describe them&#xa;Words + optional details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="fl-a"><mxGeometry x="30" y="305" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-a-invent" value="Invent the look&#xa;Use story facts + defaults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontStyle=1;" vertex="1" parent="fl-a"><mxGeometry x="270" y="305" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-a-note" value="Asked once for the whole cast. Shared photo → humans visibly “Using this photo”; pet/object visibly “Create from story · Use photo instead”; confirm ambiguous assignments.&#xa;No-character book: choose style, then create a setting / object / style sample" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;" vertex="1" parent="fl-a"><mxGeometry x="50" y="455" width="410" height="80" as="geometry"/></mxCell>
        <mxCell id="fl-a-compose" value="Composer remains available — but the guide does not open a new topic yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;" vertex="1" parent="fl-a"><mxGeometry x="50" y="620" width="410" height="55" as="geometry"/></mxCell>
        <mxCell id="fl-b" value="B. One-tap style (the first visual) → generating" style="swimlane;html=1;startSize=38;fillColor=#FFF7ED;strokeColor=#EA580C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="105" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="fl-b-header" value="Context: Maya and Leo’s look&#xa;No book style yet • the story conversation has NOT started yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;" vertex="1" parent="fl-b"><mxGeometry x="30" y="65" width="460" height="75" as="geometry"/></mxCell>
        <mxCell id="fl-b-evidence" value="“I’ll draw them in this look.”&#xa;[ ● Soft Watercolor ] [ Paper Cut ] [ Storybook Ink ]&#xa;Catalog artwork — zero cost, no generation, instant first visual&#xa;Create 2 first looks · 8 Sparks (balance after: 12)  |  Other looks  |  Choose for me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontStyle=1;" vertex="1" parent="fl-b"><mxGeometry x="30" y="180" width="460" height="125" as="geometry"/></mxCell>
        <mxCell id="fl-b-progress" value="Soft Watercolor saved → job queued&#xa;[ photo thumb ] + [ style tile ] shown as immediate evidence&#xa;Reading the photo → Drawing Maya…&#xa;████████░░  72%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontStyle=1;" vertex="1" parent="fl-b"><mxGeometry x="30" y="350" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="fl-b-chat" value="ONLY NOW does the guide pivot:&#xa;“Maya is being drawn — while that happens, what would make the birthday special?”&#xa;Never said while the style tap is still pending." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;" vertex="1" parent="fl-b"><mxGeometry x="30" y="500" width="460" height="105" as="geometry"/></mxCell>
        <mxCell id="fl-b-note" value="No visual job starts until the style is saved • derived or inherited styles skip this entirely • the story track opens only after the job is queued" style="text;html=1;fontColor=#64748B;align=center;" vertex="1" parent="fl-b"><mxGeometry x="45" y="640" width="430" height="35" as="geometry"/></mxCell>
        <mxCell id="fl-c" value="C. First look ready — revealed inline in chat" style="swimlane;html=1;startSize=38;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1215" y="105" width="540" height="720" as="geometry"/></mxCell>
