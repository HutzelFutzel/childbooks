        <mxCell id="cs-a-dog" value="Pip the dog&#xa;Queued&#xa;3 of 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontStyle=1;" vertex="1" parent="cs-a"><mxGeometry x="350" y="175" width="135" height="120" as="geometry"/></mxCell>
        <mxCell id="cs-a-copy" value="“Maya is ready. Leo is next, then Pip.”&#xa;Equal heroes are not ranked by visual prominence." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;" vertex="1" parent="cs-a"><mxGeometry x="30" y="345" width="455" height="85" as="geometry"/></mxCell>
