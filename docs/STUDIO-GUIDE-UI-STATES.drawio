        <mxCell id="sh-a" value="A. Context aligned" style="swimlane;html=1;startSize=38;fillColor=#FFF7ED;strokeColor=#EA580C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="105" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="sh-a-context" value="Editing: Story&#xa;Panel and chat both target the manuscript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontStyle=1;" vertex="1" parent="sh-a"><mxGeometry x="30" y="70" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="sh-a-outline" value="Story ✓  |  Characters ●  |  Pages ○  |  Preview ○" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="sh-a"><mxGeometry x="30" y="195" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="sh-a-facts" value="You said: Maya 5, Leo 3&#xa;I inferred: English, ages 4–6&#xa;Default: 24 pages, 8×8 hardcover · Change&#xa;Book choice: Soft Watercolor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;align=left;spacingLeft=12;" vertex="1" parent="sh-a"><mxGeometry x="30" y="300" width="460" height="115" as="geometry"/></mxCell>
        <mxCell id="sh-a-chat" value="Chat about the selected story paragraph…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;" vertex="1" parent="sh-a"><mxGeometry x="30" y="475" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="sh-a-compose" value="Story · Ask for a change…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="sh-a"><mxGeometry x="30" y="620" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="sh-b" value="B. Panel differs from guide question — tag, never a warning" style="swimlane;html=1;startSize=38;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="105" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="sh-b-banner" value="Quiet composer tag (not a banner):&#xa;Replying to: Maya’s look · talk about Story instead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="sh-b"><mxGeometry x="30" y="70" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="sh-b-actions" value="Talk about Story  |  Return to Maya’s look" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;" vertex="1" parent="sh-b"><mxGeometry x="30" y="205" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="sh-b-panel" value="MANUSCRIPT PANEL&#xa;The panel remains useful. The tag, not a dialog, tells chat what “this” means." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="sh-b"><mxGeometry x="30" y="320" width="460" height="180" as="geometry"/></mxCell>
        <mxCell id="sh-b-compose" value="Send is never blocked and nothing is warned. Tapping the tag retargets the conversation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="sh-b"><mxGeometry x="30" y="585" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="sh-c" value="C. How we’re working" style="swimlane;html=1;startSize=38;fillColor=#F3E8FF;strokeColor=#9333EA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1215" y="105" width="540" height="720" as="geometry"/></mxCell>
        <mxCell id="sh-c-owner" value="INVOLVEMENT — the only visible setting&#xa;○ Make it for me&#xa;● Make it with me (default, never asked)&#xa;○ I’ll do it myself&#xa;▸ Per-artifact rows (collapsed): Story · Characters · Pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;align=left;spacingLeft=12;" vertex="1" parent="sh-c"><mxGeometry x="30" y="70" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="sh-c-cadence" value="MONEY + ACCOUNT&#xa;Style previews cost nothing; generated images use configured Sparks&#xa;Every generation action shows quantity, charge, and balance after&#xa;Anonymous work continues with available balance&#xa;Ask “Save your book and continue” only for cross-device save, buying Sparks, or ordering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;align=left;spacingLeft=12;" vertex="1" parent="sh-c"><mxGeometry x="30" y="270" width="460" height="155" as="geometry"/></mxCell>
        <mxCell id="sh-c-note" value="Natural language updates the same settings:&#xa;“Make the characters, but let me edit the pages.”&#xa;Editing an artifact promotes it silently." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="sh-c"><mxGeometry x="45" y="475" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="sh-c-save" value="Apply changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9333EA;strokeColor=#7E22CE;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="sh-c"><mxGeometry x="155" y="610" width="210" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
