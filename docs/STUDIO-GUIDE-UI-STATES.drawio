        <mxCell id="cs-b-note" value="Panel selection retargets chat through the composer tag. “Change this” always has a named, tappable subject." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="cs-b"><mxGeometry x="55" y="610" width="410" height="65" as="geometry"/></mxCell>
