        <mxCell id="cs-b" value="B. Cast shelf ready" style="swimlane;html=1;startSize=38;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="105" width="540" height="720" as="geometry"/></mxCell>
