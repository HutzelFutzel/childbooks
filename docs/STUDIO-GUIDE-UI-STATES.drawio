        <mxCell id="st-b" value="B. Help me create it" style="swimlane;html=1;startSize=38;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="105" width="540" height="720" as="geometry"/></mxCell>
