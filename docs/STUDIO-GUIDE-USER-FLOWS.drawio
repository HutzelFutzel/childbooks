                </mxCell>
                <mxCell id="r-story" value="Story fact/text&#xa;Potentially stale: story → analysis/cast → plan → pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1">
                    <mxGeometry x="610" y="70" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="r-char" value="Character look/source&#xa;Stale: that reference + dependent pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;" vertex="1" parent="1">
                    <mxGeometry x="610" y="180" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-page" value="One page instruction&#xa;Stale: only that page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1">
                    <mxGeometry x="610" y="280" width="260" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="r-style" value="Book art style&#xa;Stale: all generated character + page art" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;" vertex="1" parent="1">
                    <mxGeometry x="610" y="375" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-receipt" value="Apply change + show exact receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="985" y="190" width="250" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="r-summary" value="One impact summary&#xa;Never one warning per downstream artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1">
                    <mxGeometry x="985" y="300" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r-update" value="Update affected work?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
