    <diagram id="checkpoint-policy" name="10. Checkpoint policy">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="k-title" value="Checkpoint policy: risk first, involvement second, and never ask twice" style="text;html=1;fontSize=26;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="25" width="850" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="k-start" value="Next operation is ready" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="135" width="185" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="k-hardq" value="Hard-stop condition?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="325" y="115" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="k-hard" value="HARD STOP&#xa;Always require explicit action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="605" y="85" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="k-hardlist" value="• likeness consent&#xa;• missing book style&#xa;• never-reviewed or ambiguous identity&#xa;• destructive overwrite of user work&#xa;• artwork rights/safety concern&#xa;• informed confirmation of every configured generation charge&#xa;• insufficient balance / payment&#xa;• print/order approval" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;align=left;spacingLeft=12;" vertex="1" parent="1">
                    <mxGeometry x="930" y="70" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="k-keyq" value="High-impact or low-confidence decision?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="325" y="310" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="k-key" value="KEY CHECKPOINT&#xa;Story ready • cast summary • page-plan approval • final page set&#xa;Skip any subject already approved by “Keep this look”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="620" y="325" width="300" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="k-soft" value="SOFT / RECOVERABLE&#xa;Optional idea • first look • defaults • background work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1">
                    <mxGeometry x="620" y="500" width="300" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="k-cadence" value="Stored cadence (written by the involvement control)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1030" y="360" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="k-take" value="MAKE IT FOR ME&#xa;Pause only at hard stops; key checkpoint becomes visible non-blocking review when confidence is high" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1">
                    <mxGeometry x="1255" y="260" width="285" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="k-check" value="MAKE IT WITH ME (default)&#xa;Pause at hard + key checkpoints; soft work continues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1255" y="405" width="285" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="k-each" value="I’LL DO IT MYSELF&#xa;Pause at hard, key, and soft artifact transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;" vertex="1" parent="1">
                    <mxGeometry x="1255" y="535" width="285" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="k-proceed" value="Proceed, version the result, keep it editable" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="650" y="735" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="k-note" value="Changing involvement is prospective: it does not cancel completed work or rewrite prior approvals. A checkpoint already answered for a specific subject must not fire again for that subject." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;" vertex="1" parent="1">
                    <mxGeometry x="1050" y="730" width="430" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ke1" edge="1" parent="1" source="k-start" target="k-hardq" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke2" value="Yes" edge="1" parent="1" source="k-hardq" target="k-hard" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke3" edge="1" parent="1" source="k-hard" target="k-hardlist" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke4" value="approved/resolved" edge="1" parent="1" source="k-hard" target="k-proceed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="730" y="680"/>
                            <mxPoint x="800" y="680"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ke5" value="No" edge="1" parent="1" source="k-hardq" target="k-keyq" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke6" value="Yes" edge="1" parent="1" source="k-keyq" target="k-key" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke7" value="No" edge="1" parent="1" source="k-keyq" target="k-soft" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke8" edge="1" parent="1" source="k-key" target="k-cadence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke9" edge="1" parent="1" source="k-soft" target="k-cadence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke10" edge="1" parent="1" source="k-cadence" target="k-take" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke11" edge="1" parent="1" source="k-cadence" target="k-check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke12" edge="1" parent="1" source="k-cadence" target="k-each" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke13" edge="1" parent="1" source="k-take" target="k-proceed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke14" edge="1" parent="1" source="k-check" target="k-proceed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ke15" edge="1" parent="1" source="k-each" target="k-proceed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
