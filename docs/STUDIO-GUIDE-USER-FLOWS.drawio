                    <mxGeometry x="40" y="25" width="760" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="m-sub" value="One visible involvement control writes ownership and cadence together. Chat persists; results appear inline; the panel is for sustained work." style="text;html=1;fontSize=14;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="920" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="m-start" value="New or returning book" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="170" width="155" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="m-entry" value="How do you want to begin the words?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="285" y="155" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="m-guided" value="Guide me&#xa;Collect a rich brief in one conversational turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;" parent="1" vertex="1">
                    <mxGeometry x="550" y="120" width="210" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="m-own" value="I already have words&#xa;Paste/open manuscript; derive stable facts and keep AI help available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;" parent="1" vertex="1">
                    <mxGeometry x="550" y="220" width="210" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="m-look" value="Visuals first, staggered&#xa;Cast card → one-tap style on real artwork → informed generation action with configured cost → queue job → story opens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="840" y="160" width="245" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-approve" value="Before page art: cast summary&#xa;Review only unresolved/stale/unreviewed subjects; separately authorize configured reference-sheet charge if sheets are missing" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="155" width="230" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="m-default" value="Involvement — one control, never a cadence question&#xa;Make it for me / Make it with me (default) / I’ll do it myself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="565" y="390" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-story" value="STORY OWNERSHIP&#xa;Create for me | Help me | I’ll provide/edit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="175" y="555" width="240" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="m-chars" value="CHARACTER OWNERSHIP&#xa;Create for me | Help me | I’ll provide/direct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="555" width="240" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="m-pages" value="PAGE OWNERSHIP&#xa;Create for me | Help design | I’ll edit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="865" y="555" width="240" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="m-finish" value="Flip-through + print preflight + checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1205" y="555" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="m-note1" value="Ownership defaults are explicit: Story follows the entry choice, Characters and Pages are created for you. Editing an artifact promotes it to “Help me create it”." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="85" y="735" width="390" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m-note2" value="Always stop for missing book style, likeness consent, conflicting uploaded styles, a never-reviewed subject, informed confirmation of every configured generation charge, insufficient balance, and print checkout. Ask for an account only when its capability is needed." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="560" y="735" width="420" height="90" as="geometry"/>
