                <mxCell id="m-note3" value="Results appear inline in the chat on every screen size. The panel opens for sustained work — manuscript, full gallery, reference sheet, page canvas, flip-through." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;fontSize=13;" parent="1" vertex="1">
