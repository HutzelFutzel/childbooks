                </mxCell>
                <mxCell id="r-input" value="Reader changes something&#xa;in chat or panel" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" vertex="1" parent="1">
