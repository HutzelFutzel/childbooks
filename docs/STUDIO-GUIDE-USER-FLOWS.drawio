    <diagram id="autonomy-matrix" name="5. Involvement: ownership × cadence">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="a-title" value="27 artifact-ownership combinations × 3 review cadences" style="text;html=1;fontSize=26;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="800" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="a-sub" value="Do not show this matrix, and do not ask the reader to fill it in. One involvement control writes both fields; the defaults are Story = entry choice, Characters and Pages = create for me. Editing an artifact promotes it to “help me create it”. This page is engineering reference only." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="930" y="25" width="780" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="a-legend" value="Cell notation: 1 = system creates, 2 = help me create, 3 = I provide/edit. Each large group fixes Story ownership." style="text;html=1;fontSize=14;fontColor=#475569;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="850" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="a-sauto" value="STORY 1: SYSTEM CREATES" style="swimlane;html=1;startSize=45;horizontal=1;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="40" y="130" width="540" height="800" as="geometry"/>
                </mxCell>
                <mxCell id="aa-h1" value="Characters \ Pages" style="text;html=1;fontStyle=1;align=center;" parent="a-sauto" vertex="1">
                    <mxGeometry x="20" y="65" width="150" height="35" as="geometry"/>
