    <diagram id="story-flow" name="2. Story paths">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="s-title" value="Story paths: source/ownership, then review cadence" style="text;html=1;fontSize=26;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="760" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="s-entry" value="Story input" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="65" y="125" width="145" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="s-mode" value="How begin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="1" vertex="1">
                    <mxGeometry x="275" y="110" width="150" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="s-guided" value="GUIDE ME&#xa;One broad brief question; infer audience, theme, setting, language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;" parent="1" vertex="1">
                    <mxGeometry x="500" y="85" width="275" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="s-own" value="I ALREADY HAVE WORDS&#xa;Paste/open manuscript; derive facts; offer optional assistance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;" parent="1" vertex="1">
                    <mxGeometry x="500" y="215" width="275" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="s-enough" value="Brief settled? Explicit instruction, or visible Create the story action after a ready summary — never inactivity, timeout, or names+ages alone" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="1" vertex="1">
                    <mxGeometry x="855" y="145" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="s-follow" value="Ask only the named missing fact or keep editor open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="90" width="225" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s-policy" value="Who creates the story?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1145" y="220" width="180" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="s-auto" value="CREATE IT FOR ME&#xa;Generate story → quality + age checks → cadence decides pause" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="165" y="415" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s-review" value="HELP ME CREATE IT&#xa;Concept/outline choices → draft → revisions in manuscript panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="650" y="415" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s-hands" value="I’LL PROVIDE OR EDIT IT&#xa;Editor first → reader writes/uses optional AI actions → Mark ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1135" y="415" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s-interrupt" value="Reader interrupts with a change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="1" vertex="1">
                    <mxGeometry x="655" y="600" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="s-apply" value="Apply fact or text edit; show receipt; mark only dependent artifacts stale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="615" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s-ready" value="Story ready for cast analysis and/or page planning" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="365" y="765" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="s-switch" value="Ownership is independent of cadence: system-created stories can still pause for review; user-provided stories can continue automatically after Mark ready." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="945" y="760" width="430" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-entry" target="s-mode" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se2" value="Guide me" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-mode" target="s-guided" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se3" value="Write it" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-mode" target="s-own" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-guided" target="s-enough" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-own" target="s-enough" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se6" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-enough" target="s-follow" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se7" value="answer/write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-follow" target="s-enough" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-enough" target="s-policy" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se9" value="Create for me" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-policy" target="s-auto" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se10" value="Help me" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-policy" target="s-review" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se11" value="I provide/edit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-policy" target="s-hands" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-auto" target="s-interrupt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-review" target="s-interrupt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-hands" target="s-interrupt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-interrupt" target="s-apply" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se16" value="No / approved / marked ready" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-interrupt" target="s-ready" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se17" value="continue under current policy" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="s-apply" target="s-interrupt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="character-flow" name="3. Character and style paths">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c-title" value="Character source, art style, approval, and autonomy" style="text;html=1;fontSize=26;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="900" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="c-start" value="Named primary character" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="125" width="180" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="c-source" value="One cast card: how should they look?&#xa;Asked once for everyone named" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="315" y="105" width="210" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="c-photo" value="PHOTO&#xa;Camera/upload + likeness consent → private source deleted when no longer needed, hard-expiry within 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;" parent="1" vertex="1">
                    <mxGeometry x="620" y="70" width="245" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="c-art" value="EXISTING ARTWORK&#xa;Upload now or choose reusable character later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;" parent="1" vertex="1">
                    <mxGeometry x="620" y="185" width="245" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="c-desc" value="DESCRIBE&#xa;Free text + optional appearance chips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;" parent="1" vertex="1">
                    <mxGeometry x="620" y="290" width="245" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c-invent" value="INVENT&#xa;Use age, role, story, and safe defaults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;" parent="1" vertex="1">
