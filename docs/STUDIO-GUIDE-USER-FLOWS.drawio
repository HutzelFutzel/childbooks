    <diagram id="panel-behavior" name="6. Surfaces: chat and panel">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="d-title" value="Surfaces: decisions and results in chat, sustained work in the panel" style="text;html=1;fontSize=26;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="980" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="d-chat" value="CHAT&#xa;Always mounted&#xa;Questions, free text, receipts, progress narration, interruption" style="swimlane;html=1;startSize=42;fillColor=#FFF7ED;strokeColor=#EA580C;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="50" y="110" width="410" height="720" as="geometry"/>
                </mxCell>
                <mxCell id="d-strip" value="Persistent compact strip&#xa;Known facts + defaults • progress • involvement • “style previews cost nothing; generation uses Sparks” + balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;" parent="d-chat" vertex="1">
                    <mxGeometry x="35" y="75" width="340" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d-transcript" value="Transcript&#xa;Guide lines + reader bubbles + applied-value receipts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;" parent="d-chat" vertex="1">
                    <mxGeometry x="35" y="195" width="340" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="d-widgets" value="Inline answer widgets&#xa;Choice cards • uploads • confirmations • retry • skip when honest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;" parent="d-chat" vertex="1">
                    <mxGeometry x="35" y="440" width="340" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="d-composer" value="Composer never disappears during generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontStyle=1;" parent="d-chat" vertex="1">
                    <mxGeometry x="35" y="590" width="340" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d-trigger" value="Panel selection trigger" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="540" y="370" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="d-panel" value="CONTEXT PANEL&#xa;One active surface, replaceable without changing the conversation" style="swimlane;html=1;startSize=42;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="810" y="110" width="730" height="720" as="geometry"/>
                </mxCell>
                <mxCell id="d-hidden" value="Hidden / facts summary&#xa;Pure conversation; reader closed panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;" parent="d-panel" vertex="1">
                    <mxGeometry x="35" y="70" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d-manuscript" value="Manuscript&#xa;Writing, draft review, revisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;" parent="d-panel" vertex="1">
                    <mxGeometry x="265" y="70" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d-style" value="Full style gallery&#xa;Only on “See all styles”; the one-tap confirmation lives in chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;" parent="d-panel" vertex="1">
                    <mxGeometry x="495" y="70" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d-portrait" value="Reference sheet, close up&#xa;Inspection only — first looks are revealed and approved inline in chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;" parent="d-panel" vertex="1">
                    <mxGeometry x="35" y="200" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d-plan" value="Page plan&#xa;Co-design/edit, or cadence checkpoint before rendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;" parent="d-panel" vertex="1">
                    <mxGeometry x="265" y="200" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d-pages" value="Page canvas&#xa;Progress, text/layout edits, assets, selective regeneration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;" parent="d-panel" vertex="1">
                    <mxGeometry x="495" y="200" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d-preview" value="Flip-through + preflight&#xa;Final review, format, print, ebook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;" parent="d-panel" vertex="1">
                    <mxGeometry x="150" y="350" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d-error" value="Local error/recovery&#xa;Failed unit, upload issue, affordability gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;" parent="d-panel" vertex="1">
                    <mxGeometry x="430" y="350" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d-rules" value="Auto-open: required action, error, explicit request — never for a result already shown in chat.&#xa;Peek: ordinary background progress.&#xa;Respect close: do not reopen for routine progress.&#xa;Targeting: a quiet composer tag (“Replying to: Maya’s look”), never a warning banner or a blocked send.&#xa;Mobile: Book tab is for reading and inspection; results and actions stay in the conversation." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=13;" parent="d-panel" vertex="1">
                    <mxGeometry x="105" y="500" width="520" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="de1" value="current decision, newest result, error, or user request" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="d-chat" target="d-trigger" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="d-trigger" target="d-panel" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de3" value="panel actions update the same book and appear as receipts" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" parent="1" source="d-panel" target="d-chat" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1175" y="880"/>
                            <mxPoint x="255" y="880"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="recovery-flow" name="7. Change and recovery">
        <mxGraphModel dx="1700" dy="980" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
