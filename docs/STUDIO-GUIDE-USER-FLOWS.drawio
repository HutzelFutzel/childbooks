                <mxCell id="1" parent="0"/>
                <mxCell id="pv-title" value="Earliest possible visual, staggered then parallel" style="text;html=1;fontSize=26;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="900" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="pv-sub" value="Style examples are real artwork and cost nothing, so illustration is on screen first. The story track opens only once a visual job is queued — never before." style="text;html=1;fontSize=14;fontColor=#475569;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="1050" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pv-start" value="Minimum stable facts arrive&#xa;Name + age, pasted-story subject, or explicit non-character visual" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="70" y="135" width="255" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="pv-subject" value="What is the earliest honest visual subject?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="405" y="120" width="225" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="pv-character" value="Named cast&#xa;Intake covers everyone at once; render queue may be sequential and is named out loud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;" parent="1" vertex="1">
                    <mxGeometry x="720" y="105" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="pv-other" value="No character&#xa;Use setting, important object, or style sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;" parent="1" vertex="1">
                    <mxGeometry x="720" y="215" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pv-launch" value="Cast card → one-tap style → show configured generation charge + balance after → confirm → queue visual job&#xa;(story track opens after this, not before)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="145" width="245" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pv-storylane" value="STORY TRACK" style="swimlane;html=1;startSize=42;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="70" y="350" width="735" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="pv-story1" value="Continue conversation or manuscript&#xa;Do not wait for image generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;" parent="pv-storylane" vertex="1">
                    <mxGeometry x="40" y="85" width="200" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="pv-story2" value="Draft / co-create / reader writes&#xa;Show stated facts and inferred assumptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;" parent="pv-storylane" vertex="1">
                    <mxGeometry x="275" y="85" width="210" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="pv-story3" value="Story ready under selected ownership + cadence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontStyle=1;" parent="pv-storylane" vertex="1">
                    <mxGeometry x="520" y="85" width="180" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="pv-storynote" value="If the visual fails, the story track continues. If the story changes visual facts, the visual result is provenance-checked before reveal." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;" parent="pv-storylane" vertex="1">
                    <mxGeometry x="145" y="225" width="450" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pv-visuallane" value="FIRST-LOOK TRACK" style="swimlane;html=1;startSize=42;fillColor=#FDF2F8;strokeColor=#DB2777;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="880" y="350" width="850" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="pv-source" value="Unified cast intake&#xa;One card, everyone named: photo + consent (incl. a shared photo with face-to-name) / artwork / describe / invent / sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;" parent="pv-visuallane" vertex="1">
                    <mxGeometry x="25" y="75" width="225" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="pv-immediate" value="Book style as the first visual reward&#xa;Catalog example artwork: derived-style confirmation, or recommended tile + alternates — zero cost, no generation, no wait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;" parent="pv-visuallane" vertex="1">
                    <mxGeometry x="275" y="75" width="225" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="pv-render" value="Style saved → show configured cost + resulting balance → confirm → job queued → render&#xa;Story track opens here; composer stays active; honest stages only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;fontStyle=1;" parent="pv-visuallane" vertex="1">
                    <mxGeometry x="525" y="75" width="205" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="pv-current" value="Succeeded + inputs still current?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="pv-visuallane" vertex="1">
                    <mxGeometry x="745" y="75" width="85" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="pv-stale" value="Failed: retry/change source/describe/invent/sample.&#xa;Stale: keep older version; regenerate latest without flashing it as current." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;" parent="pv-visuallane" vertex="1">
                    <mxGeometry x="510" y="220" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pv-result" value="Reveal “First look” inline in chat&#xa;Keep (= approval only, never another charge) • Tweak • New source • Another style • Recreate later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#DB2777;fontStyle=1;" parent="pv-visuallane" vertex="1">
                    <mxGeometry x="185" y="215" width="285" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="pv-join" value="Story ready + first-look track resolved enough to continue" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="690" y="760" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="pv-cast" value="Complete the required cast&#xa;Your people vs. everything else; Keep approves only; create reference sheets with one separately priced batch action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="770" width="285" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="pv-lock" value="Cast summary before page art&#xa;Review only unresolved/stale/unreviewed looks; if sheets are missing, separately authorize the configured reference-sheet batch charge" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="755" width="250" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="pv-pages" value="Page plan + dependent illustrations" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="940" width="245" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="pv-later" value="Later recreation stays available; first explain affected sheets/pages and cost, then update only dependants. “Recreate later” leaves a visible pending item, and the page cost gate names the look the pages will use." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="935" width="500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pve1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-start" target="pv-subject" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve2" value="Character" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-subject" target="pv-character" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve3" value="No character" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-subject" target="pv-other" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-character" target="pv-launch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-other" target="pv-launch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve6" value="only once the job is queued" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-launch" target="pv-story1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-launch" target="pv-source" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-story1" target="pv-story2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-story2" target="pv-story3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-source" target="pv-immediate" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-immediate" target="pv-render" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-render" target="pv-current" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve13" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-current" target="pv-result" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pve14" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" parent="1" source="pv-current" target="pv-stale" edge="1">
